{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/viewer/cc_hook.py\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/viewer/cc_hook.py\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/viewer/cc_hook.py\" post",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/viewer/cc_hook.py\" edit",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/viewer/cc_hook.py\" post",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
